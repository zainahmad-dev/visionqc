# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API). .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — grants full database access, bypassing Row Level Security.
# Used ONLY on the server (lib/data/*), inside code marked "use server" or
# "server-only". Never import it into a Client Component, never send it to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama — local vision inference (lib/ollama.ts, server-only). All three are
# optional; the defaults below match a stock `ollama serve` with a pulled
# vision model. Never NEXT_PUBLIC_ — the host and model name must never reach
# the browser.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=moondream
# OLLAMA_TIMEOUT_MS=120000
